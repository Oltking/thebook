type ContractError = enum {
  NotAuthorized,
  NotAdmin,
  BadParams,
  JoinFirst,
  InsufficientUsd,
  InsufficientAsset,
  OrderNotFound,
  OrderAlreadyDone,
  NoLiquidity,
  NoBuyers,
  PoolExists,
  PoolNotFound,
  SameAssetPool,
  InsufficientLiquidity,
  SlippageExceeded,
  ZeroAmount,
  AgentCallFailed,
  BookFull,
  NoMarkPrice,
  LeverageTooHigh,
  PositionNotFound,
  WrongDirection,
  NotLiquidatable,
  StaleMark,
};

/// The four balances the DEX custodies, each backed by a real VFT on-chain.
/// `Usd` is a separate kind because the orderbook denominates in USD but the
/// `Asset` enum only covers the tradeable tokens (BTC/ETH/VARA).
type TokenKind = enum {
  Usd,
  Btc,
  Eth,
  Vara,
};

/// The trading persona a user picks when creating their agent. Display/behaviour
/// hint today; drives autopilot strategy selection in a later phase.
type AgentStrategy = enum {
  ArbitrageHunter,
  MarketMaker,
  Momentum,
};

type Asset = enum {
  BTC,
  ETH,
  VARA,
};

type Side = enum {
  Buy,
  Sell,
};

type LeaderEntry = struct {
  id: actor_id,
  name: str,
  strategy: AgentStrategy,
  usd: u64,
  net_worth: u64,
};

type OrderStatus = enum {
  Open,
  Partial,
  Filled,
  Cancelled,
};

type OrderPlacedEvent = struct {
  trader: actor_id,
  side: Side,
  asset: Asset,
  price: u64,
  qty: u64,
  order_id: u64,
};

type OrderCancelledEvent = struct {
  trader: actor_id,
  order_id: u64,
};

type TradeEvent = struct {
  trade_id: u64,
  asset: Asset,
  price: u64,
  qty: u64,
  buyer: actor_id,
  seller: actor_id,
};

type LpPosition = struct {
  pool_id: u64,
  provider: actor_id,
  amount: u64,
  share_a: u64,
  share_b: u64,
};

type Pool = struct {
  id: u64,
  asset_a: Asset,
  asset_b: Asset,
  reserve_a: u64,
  reserve_b: u64,
  total_lp: u64,
  creator: actor_id,
};

type PoolCreatedEvent = struct {
  pool_id: u64,
  asset_a: Asset,
  asset_b: Asset,
  creator: actor_id,
};

type LiquidityAddedEvent = struct {
  pool_id: u64,
  provider: actor_id,
  amount_a: u64,
  amount_b: u64,
  lp_minted: u64,
};

type LiquidityRemovedEvent = struct {
  pool_id: u64,
  provider: actor_id,
  amount_a: u64,
  amount_b: u64,
  lp_burned: u64,
};

type SwapExecutedEvent = struct {
  pool_id: u64,
  trader: actor_id,
  asset_in: Asset,
  amount_in: u64,
  asset_out: Asset,
  amount_out: u64,
  fee: u64,
};

type MarkPriceEvent = struct {
  asset: Asset,
  price: u64,
};

type PerpOpenedEvent = struct {
  owner: actor_id,
  asset: Asset,
  is_long: bool,
  size: u64,
  entry: u64,
  margin: u64,
  leverage: u32,
};

type PerpClosedEvent = struct {
  owner: actor_id,
  asset: Asset,
  exit: u64,
  payout: u64,
  pnl: i64,
  liquidated: bool,
};

type SpotError = enum {
  /// Caller is not the admin/multisig.
  NotAdmin,
  /// Zero price/qty, unknown token, or other malformed input.
  BadParams,
  /// A pair with the same (base, quote) already exists.
  PairExists,
  /// No pair with that id.
  NoPair,
  /// Pair exists but is delisted; no new orders accepted.
  PairInactive,
  /// The global order cap is reached.
  BookFull,
  /// No order with that id.
  NoOrder,
  /// Caller does not own that order.
  NotOwner,
  /// Nothing to withdraw for that token.
  NothingToClaim,
  /// The on-chain VFT transfer failed (bad allowance/balance, or program error).
  TransferFailed,
};

type SpotOrder = struct {
  id: u64,
  pair_id: u64,
  trader: actor_id,
  side: Side,
  /// Quote smallest-units per one whole base token (per 10^base_dec base units).
  price: u128,
  /// Order size in base token smallest units.
  qty: u128,
  /// Filled base amount so far.
  filled: u128,
  status: SpotStatus,
};

type SpotStatus = enum {
  Open,
  PartiallyFilled,
  Filled,
  Cancelled,
};

type SpotPair = struct {
  id: u64,
  /// Base token program (the asset being bought/sold).
  base: actor_id,
  /// Quote token program (USDT or USDC).
  quote: actor_id,
  /// Declared decimals of each token, read from the VFT at listing time.
  base_dec: u8,
  quote_dec: u8,
  /// Delisted pairs reject new orders but still allow cancel/withdraw.
  active: bool,
};

type PerpsError = enum {
  NotAdmin,
  NotKeeper,
  BadParams,
  NoMarket,
  MarketInactive,
  StaleMark,
  LeverageTooHigh,
  InsufficientMargin,
  PositionNotFound,
  NotLiquidatable,
  BookFull,
  TransferFailed,
  NoCollateral,
};

type PerpMarket = struct {
  id: u64,
  symbol: str,
  /// Mark price (arbitrary consistent units; PnL uses price ratios so the unit cancels).
  mark: u128,
  /// Block the mark was last published.
  mark_block: u32,
  active: bool,
};

constructor {
  New : ();
};

service Orderbook {
  CallAgentService : (target: actor_id, payload: vec u8, gas_limit: u64) -> result (vec u8, ContractError);
  CancelOrder : (oid: u64) -> result (null, ContractError);
  /// Move real VFT tokens from the caller into the DEX vault, crediting their
  /// internal balance. The caller must have `approve`d the DEX on the token
  /// program for at least `amount` first. Credits only after the on-chain
  /// transfer succeeds, so the internal balance stays fully token-backed.
  Deposit : (kind: TokenKind, amount: u64) -> result (u64, ContractError);
  /// Register the caller's agent identity (name + strategy) and grant the
  /// starting balances. This is the virtual-balance model: an agent is funded
  /// the instant it joins, so it can trade immediately with no token custody,
  /// approve, or deposit step. Idempotent: re-joining returns the existing
  /// balances and keeps the original identity (no double funding).
  Join : (name: str, strategy: AgentStrategy) -> struct { u64, u64, u64, u64 };
  MarketBuy : (asset: Asset, qty: u64) -> result (str, ContractError);
  MarketSell : (asset: Asset, qty: u64) -> result (str, ContractError);
  PlaceLimit : (side: Side, asset: Asset, price: u64, qty: u64) -> result (u64, ContractError);
  /// Admin-only, one-time: grant the house (admin) a deep USDT + asset stockpile
  /// so the market maker can quote both sides and USDT-only agents always have a
  /// counterparty. Idempotent — after the first call it just returns the balances.
  SeedHouse : () -> result (struct { u64, u64, u64, u64 }, ContractError);
  /// Admin-only: register the VFT program ID that backs a custodied balance.
  /// Must be set before deposit/withdraw can move real tokens for that kind.
  SetToken : (kind: TokenKind, address: actor_id) -> result (null, ContractError);
  StartAutopilot : () -> null;
  Tick : () -> result (str, ContractError);
  /// Withdraw real VFT tokens from the DEX vault back to the caller. Debits the
  /// internal balance first, then transfers on-chain; if the transfer fails the
  /// debit is reverted so funds are never silently lost.
  Withdraw : (kind: TokenKind, amount: u64) -> result (u64, ContractError);
  /// Caller's agent identity, or None if they haven't joined. Used by the UI to
  /// decide whether to show the "Create your Agent" onboarding.
  query GetIdentity : () -> opt struct { str, AgentStrategy };
  query GetLeaderboard : (limit: u32) -> vec LeaderEntry;
  query GetMyOrders : () -> vec struct { u64, Side, Asset, u64, u64, u64, OrderStatus };
  query GetOrderbook : (asset: Asset) -> struct { vec struct { u64, u64 }, vec struct { u64, u64 } };
  query GetPortfolio : () -> struct { u64, u64, u64, u64 };
  query GetStatus : () -> struct { u32, u64, u32, bool, u32 };
  query GetToken : (kind: TokenKind) -> actor_id;
  /// All four token registrations as (usd, btc, eth, vara) for the UI/agents.
  query GetTokens : () -> struct { actor_id, actor_id, actor_id, actor_id };
  query GetTrades : (asset: Asset, limit: u32) -> vec struct { u64, u64, u64, actor_id, actor_id };

  events {
    OrderPlaced: OrderPlacedEvent;
    OrderCancelled: OrderCancelledEvent;
    Trade: TradeEvent;
  }
};

service Amm {
  AddLiquidity : (pool_id: u64, amount_a: u64, amount_b: u64) -> result (u64, ContractError);
  CreatePool : (asset_a: Asset, asset_b: Asset) -> result (u64, ContractError);
  RemoveLiquidity : (pool_id: u64, lp_amount: u64) -> result (struct { u64, u64 }, ContractError);
  Swap : (pool_id: u64, asset_in: Asset, amount_in: u64, min_amount_out: u64) -> result (u64, ContractError);
  query GetLpPosition : (pool_id: u64, provider: actor_id) -> opt LpPosition;
  query GetPool : (pool_id: u64) -> opt Pool;
  query ListPools : () -> vec Pool;

  events {
    PoolCreated: PoolCreatedEvent;
    LiquidityAdded: LiquidityAddedEvent;
    LiquidityRemoved: LiquidityRemovedEvent;
    SwapExecuted: SwapExecutedEvent;
  }
};

service Perps {
  /// Close your whole position at the current mark price, settling PnL against the
  /// house reserve. Returns `(payout_cents, pnl_cents_signed)`.
  ClosePosition : (asset: Asset) -> result (struct { u64, i64 }, ContractError);
  /// Admin: move USD (cents) from your own balance into the house reserve that
  /// pays trader profits. Never mints — total custodied USD is unchanged.
  FundReserve : (amount: u64) -> result (u64, ContractError);
  /// Permissionless liquidation: if a position's equity has fallen to the
  /// maintenance margin, anyone may close it at the mark. The liquidator earns a
  /// small fee from the residual equity; the rest flows to the reserve.
  Liquidate : (owner: actor_id, asset: Asset) -> result (null, ContractError);
  /// Open (or add to) an isolated-margin perpetual position. Locks `margin` USD
  /// cents from your balance; position size = margin * leverage at the mark price.
  OpenPosition : (asset: Asset, is_long: bool, margin: u64, leverage: u32) -> result (u64, ContractError);
  /// Keeper-only: publish the mark price (USD cents) for an asset. This is the
  /// price PnL and liquidations settle at — like GMX/Pyth keepers pushing a feed.
  SetMarkPrice : (asset: Asset, price: u64) -> result (null, ContractError);
  /// Keeper convenience: push all three marks at once (BTC, ETH, VARA), each in
  /// USD cents. A zero leaves that asset's mark unchanged.
  SetMarkPrices : (btc: u64, eth: u64, vara: u64) -> result (null, ContractError);
  /// Liquidation price (USD cents) for a position, i.e. the mark at which equity
  /// hits maintenance margin. 0 if there is no such position.
  query GetLiqPrice : (owner: actor_id, asset: Asset) -> u64;
  query GetMarkPrice : (asset: Asset) -> u64;
  query GetMarkPrices : () -> struct { u64, u64, u64 };
  /// A trader's open positions as
  /// `(asset, is_long, size, entry, margin, leverage, pnl_at_mark)`.
  query GetPositions : (owner: actor_id) -> vec struct { Asset, bool, u64, u64, u64, u32, i64 };
  query GetReserve : () -> u64;

  events {
    MarkPrice: MarkPriceEvent;
    Opened: PerpOpenedEvent;
    Closed: PerpClosedEvent;
  }
};

service Spot {
  /// Cancel an open order and refund its unfilled escrow to the caller's claimable
  /// balance (quote for a buy, base for a sell).
  CancelOrder : (order_id: u64) -> result (null, SpotError);
  /// Stop accepting new orders on a pair. Existing orders can still be cancelled and
  /// proceeds withdrawn. Admin-only.
  DelistPair : (pair_id: u64) -> result (null, SpotError);
  /// Curate a new TOKEN/quote market. Admin-only (multisig on mainnet). `base_dec`
  /// and `quote_dec` are the tokens' declared decimals; the caller supplies them so
  /// listing stays synchronous (they are verifiable against each VFT's metadata).
  ListPair : (base: actor_id, quote: actor_id, base_dec: u8, quote_dec: u8) -> result (u64, SpotError);
  /// Market buy up to `qty` base, spending at most `max_quote` quote tokens. Escrows
  /// the full budget up front, sweeps the asks cheapest-first, and refunds anything
  /// unspent (including the whole budget if the book is empty) to the caller's claim.
  /// Never rests. Requires a prior `approve` of `max_quote` on the quote token.
  MarketBuy : (pair_id: u64, qty: u128, max_quote: u128) -> result (u64, SpotError);
  /// Market sell `qty` base into the bids, highest-first. Escrows the base up front,
  /// credits quote proceeds, and refunds any unfilled base to the caller's claim.
  /// Never rests. Requires a prior `approve` of `qty` on the base token.
  MarketSell : (pair_id: u64, qty: u128) -> result (u64, SpotError);
  /// Place a limit order. Escrows the caller's real tokens (a quote-token
  /// `TransferFrom` for a buy, base-token for a sell — requires a prior `approve`),
  /// then crosses the book by price-time priority, crediting fills to claimable
  /// balances. Any unfilled remainder rests. Reverts with no state change if the
  /// escrow transfer fails.
  PlaceLimit : (pair_id: u64, side: Side, price: u128, qty: u128) -> result (u64, SpotError);
  /// Hand listing/admin authority to a new account (the multisig on mainnet).
  /// Admin-only; irreversible except by the new admin.
  TransferAdmin : (new_admin: actor_id) -> result (null, SpotError);
  /// Withdraw the caller's full claimable balance of `token` to their wallet. Debits
  /// optimistically and restores the claim if the on-chain transfer fails.
  Withdraw : (token: actor_id) -> result (u128, SpotError);
  /// The caller's withdrawable balance for a given token program.
  query GetClaim : (token: actor_id) -> u128;
  /// The caller's open/closed orders.
  query GetMyOrders : () -> vec SpotOrder;
  /// Aggregated resting depth for a pair: (bids desc by price, asks asc by price),
  /// each level `(price, remaining_qty)`.
  query GetOrderbook : (pair_id: u64) -> struct { vec struct { u128, u128 }, vec struct { u128, u128 } };
  query GetPair : (pair_id: u64) -> opt SpotPair;
  query GetPairs : () -> vec SpotPair;
};

service PerpsV1 {
  /// Admin: list a perp market by symbol. Returns its id.
  AddMarket : (symbol: str) -> result (u64, PerpsError);
  /// Close your position at the current mark, settling PnL against the reserve and
  /// crediting the payout to your claimable collateral (withdraw via `Spot/Withdraw`).
  ClosePosition : (position_id: u64) -> result (struct { u128, i128 }, PerpsError);
  /// Admin: fund the house reserve with real collateral (requires a prior `approve`).
  FundReserve : (amount: u128) -> result (u128, PerpsError);
  /// Permissionless liquidation once equity falls to maintenance margin. The
  /// liquidator earns a fee from residual equity; the rest is settled to the owner.
  Liquidate : (position_id: u64) -> result (null, PerpsError);
  /// Open an isolated-margin position. Escrows `margin` of the collateral token
  /// (requires a prior `approve`); notional = margin * leverage at the mark.
  OpenPosition : (market_id: u64, is_long: bool, margin: u128, leverage: u32) -> result (u64, PerpsError);
  /// Admin: set the collateral (settlement) token — the USDT VFT program.
  SetCollateral : (token: actor_id) -> result (null, PerpsError);
  /// Admin: set the keeper account allowed to push mark prices.
  SetKeeper : (keeper: actor_id) -> result (null, PerpsError);
  /// Keeper: publish the mark price for a market.
  SetMark : (market_id: u64, price: u128) -> result (null, PerpsError);
  /// Liquidation price for a position (0 if none).
  query GetLiqPrice : (position_id: u64) -> u128;
  query GetMarkets : () -> vec PerpMarket;
  /// A trader's open positions with PnL at the current mark:
  /// `(id, market_id, is_long, notional, entry, margin, leverage, pnl)`.
  query GetPositions : (owner: actor_id) -> vec struct { u64, u64, bool, u128, u128, u128, u32, i128 };
  query GetReserve : () -> u128;
};

