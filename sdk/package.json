    "url": "https://github.com/Oltking/thebook/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@gear-js/api": "0.45.0",
    "@polkadot/api": "12.4.2",
    "@polkadot/wasm-crypto": "^7.5.4",
    "sails-js": "0.5.1",
    "sails-js-parser": "0.5.1"
