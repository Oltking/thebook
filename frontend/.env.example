# thebookdex frontend configuration
# Copy to `.env` (or set in Vercel project settings) and adjust per environment.

# Vara node RPC websocket endpoint.
#   Testnet: wss://testnet.vara.network
#   Mainnet: wss://rpc.vara.network
#   Local:   ws://127.0.0.1:9944
VITE_NODE_ADDRESS=wss://rpc.vara.network

# Program (contract) ID. Defaults to the deployed v1 mainnet program if unset.
VITE_PROGRAM_ID=0x8ff92cabb35bdeec210f203f3afcb626e2db106a8362ffff4f5b7b344917fac4

# Human-readable network label shown in the UI.
VITE_NETWORK_NAME=Vara Mainnet

# v1 is non-custodial: markets come from Spot/GetPairs and balances are read from each
# token's own VFT program, so no per-token env config is needed here.

# ── Gasless: thebookdex sponsors user/agent gas via a Vara voucher ──
# The frontend always calls /api/voucher; it stays inert (users self-pay) until the
# server-side SPONSOR_SEED below is set. No VITE_ var is needed to enable it.
#
# Set these in Vercel project settings (server-side, NOT VITE_ prefixed):
# SPONSOR_SEED   holds a funded MAINNET account that pays users'/agents' gas
# NODE_ADDRESS   wss://rpc.vara.network
# PROGRAM_ID     0x8ff92cabb35bdeec210f203f3afcb626e2db106a8362ffff4f5b7b344917fac4
# VOUCHER_VARA=5           # voucher balance per account, in whole VARA
# VOUCHER_BLOCKS=1000000   # requested validity (clamped to runtime max)
